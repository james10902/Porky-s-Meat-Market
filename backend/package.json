{
  "name": "porkys-meat-market-api",
  "version": "1.0.0",
  "description": "REST API backend for Porky's Meat Market e-commerce platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 15000,
    "setupFilesAfterFramework": []
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "express-validator": "7.1.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "knex": "^3.1.0",
    "morgan": "1.10.0",
    "pg": "8.12.0",
    "sql.js": "^1.12.0",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.4",
    "supertest": "7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
