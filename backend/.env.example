# ============================================================================
# PORKY'S MEAT MARKET - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables required for the backend API.
# Copy this file to .env and update values for your environment.
# IMPORTANT: Never commit the .env file to version control!
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# NODE_ENV: Application environment (development, staging, production)
# - development: Enables debug logging, hot reload, detailed error messages
# - staging: Production-like environment for testing
# - production: Optimized for performance, minimal logging
NODE_ENV=development

# PORT: Server port number
# - Development: 3000 (default)
# - Production: 80 (HTTP) or 443 (HTTPS)
PORT=3000

# HOST: Server hostname/IP address to bind to
# - localhost: Only accessible from local machine
# - 0.0.0.0: Accessible from any network interface
HOST=localhost

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection settings for the primary database

# DB_HOST: PostgreSQL server hostname or IP address
# - localhost: Local development database
# - db.example.com: Remote database server
DB_HOST=localhost

# DB_PORT: PostgreSQL server port (default: 5432)
DB_PORT=5432

# DB_NAME: Database name to connect to
# - porky_market: Development database
# - porky_market_prod: Production database
DB_NAME=porky_market

# DB_USER: PostgreSQL user account
# - postgres: Default superuser (development only)
# - app_user: Dedicated application user (production)
DB_USER=postgres

# DB_PASSWORD: PostgreSQL user password
# SECURITY: Use strong passwords in production (min 16 characters)
# SECURITY: Never use default passwords in production
DB_PASSWORD=password

# DATABASE_URL: Full PostgreSQL connection string (alternative to individual settings)
# Format: postgresql://user:password@host:port/database
# If set, this takes precedence over individual DB_* variables
# DATABASE_URL=postgresql://postgres:password@localhost:5432/porky_market

# ============================================================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================================================
# JSON Web Token settings for user authentication and authorization

# JWT_SECRET: Secret key for signing JWT tokens
# SECURITY: Must be a strong random string (min 32 characters)
# SECURITY: Generate with: openssl rand -base64 32
# SECURITY: Change this value in production - never use default!
# SECURITY: If compromised, all existing tokens become invalid
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# JWT_EXPIRY: Token expiration time
# - 7d: 7 days (typical for web apps)
# - 24h: 24 hours (more secure)
# - 1h: 1 hour (very secure, requires frequent refresh)
# Format: <number><unit> where unit is: s, m, h, d, w, y
JWT_EXPIRY=7d

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Cross-Origin Resource Sharing settings for frontend communication

# CORS_ORIGIN: Allowed frontend origin(s) for API requests
# - http://localhost:8000: Local development frontend
# - https://example.com: Production frontend domain
# - Multiple origins: Use comma-separated list (no spaces)
# SECURITY: Restrict to known frontend domains in production
CORS_ORIGIN=http://localhost:8000

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# API rate limiting to prevent abuse and DDoS attacks

# RATE_LIMIT_WINDOW_MS: Time window for rate limiting in milliseconds
# - 900000: 15 minutes (default)
# - 3600000: 1 hour
# - 60000: 1 minute (strict)
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX_REQUESTS: Maximum requests per window per IP
# - 100: Default (reasonable for most APIs)
# - 1000: Generous (for high-traffic endpoints)
# - 10: Strict (for sensitive endpoints like login)
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# API CONFIGURATION
# ============================================================================
# API endpoint and routing settings

# API_PREFIX: Base path for all API endpoints
# - /api: Standard REST API prefix
# - /api/v1: Versioned API (for future compatibility)
API_PREFIX=/api

# ============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================================================
# Email service settings for notifications and alerts
# Leave empty if email notifications are not required

# SMTP_HOST: SMTP server hostname
# - smtp.gmail.com: Gmail SMTP server
# - smtp.sendgrid.net: SendGrid SMTP server
# - mail.example.com: Custom mail server
SMTP_HOST=smtp.gmail.com

# SMTP_PORT: SMTP server port
# - 587: TLS (recommended)
# - 465: SSL
# - 25: Unencrypted (not recommended)
SMTP_PORT=587

# SMTP_USER: SMTP authentication username
# - your_email@gmail.com: Gmail account
# - api_user@sendgrid.net: SendGrid API user
SMTP_USER=your_email@gmail.com

# SMTP_PASSWORD: SMTP authentication password
# SECURITY: Use app-specific passwords, not account passwords
# SECURITY: For Gmail: Use 16-character app password
SMTP_PASSWORD=your_app_password

# ============================================================================
# ENVIRONMENT-SPECIFIC NOTES
# ============================================================================
# DEVELOPMENT:
#   - Use localhost for all services
#   - Use weak passwords (for convenience)
#   - Enable debug logging
#   - Use shorter JWT expiry for testing
#
# STAGING:
#   - Use production-like settings
#   - Use strong passwords
#   - Test with realistic data
#   - Monitor performance
#
# PRODUCTION:
#   - Use strong, unique passwords (min 16 characters)
#   - Use secure, random JWT_SECRET
#   - Restrict CORS_ORIGIN to known domains
#   - Use environment-specific database
#   - Enable monitoring and alerting
#   - Use HTTPS only (set in reverse proxy)
#   - Regularly rotate secrets
#   - Use secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
# ============================================================================
